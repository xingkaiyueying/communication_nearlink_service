########################### nearlink_service feture ###########################

if (nearlink_service_kia_enable) {
  nearlink_service_external_deps += [ "security_guard:libsg_collect_sdk" ]
  nearlink_service_defines += [ "NEARLINK_KIA_ENABLE" ]
}

if (nearlink_service_edm_enable) {
  nearlink_service_sources += [
    "src/common/SleEdmManager.cpp",
  ]
  nearlink_service_defines += [ "NEARLINK_EDM_ENABLE" ]
}

if (nearlink_service_host_dynamic_running) {
  nearlink_service_external_deps += [ "hdf_core:libhdi" ]
  nearlink_service_defines += ["NEARLINK_HOST_DYNAMIC_RUNING"]
}

if (nearlink_service_no_pairing_dialog) {
  nearlink_service_defines += ["NO_PAIRING_DIALOG"]
}

if (nearlink_service_sync_ap_to_mcu) {
    nearlink_service_defines += ["NEARLINK_SYNC_AP_TO_MCU"]
}

if (nearlink_service_min_conn_interval != 0) {
    nearlink_service_defines += [ "MIN_CONN_INTERVAL=${nearlink_service_min_conn_interval}" ]
}

